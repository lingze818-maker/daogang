# 可选。不填则分发器只用关键词兜底，不访问网络。
# 不要把真实密钥写进仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DAOGANG_FLASH_MODEL=deepseek-flash

# 审计与接单状态目录，默认是当前目录下的 .daogang/
# DAOGANG_HOME=

# 演示招领。设为 task 或 chat 时，这一腿在接单前失败并落成招领行。
# DAOGANG_FAIL_LANE=

# 执行口。默认 local。dsh 只走到未接线的适配器，派工落成招领，不会安装 DSH。
# DAOGANG_EXECUTOR=local
