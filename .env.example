# 可选。不填则分发器只用关键词兜底，不访问网络。
# 不要把真实密钥写进仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DAOGANG_FLASH_MODEL=deepseek-flash

# 审计与接单状态目录，默认是当前目录下的 .daogang/
# DAOGANG_HOME=

# 演示招领。设为 task 或 chat 时，这一腿在接单前失败并落成招领行。
# DAOGANG_FAIL_LANE=

# 执行口。默认 local，不需要安装 DSH。
# local 始终走本地记录。dsh 且没有下面的根目录时，派工落成招领。
# DAOGANG_EXECUTOR=local
#
# 可选。指向本机单独 clone 的 dsh-superagent-prototype 根目录，不要把该仓复制进本仓。
# 设置后（且执行口不是显式 local）会按路径加载其中的 DshExecutor，调用
# start → enqueue('launch') 与 deliver → enqueue('delivery')。
# 这不会拉起 worker Session。克隆缺依赖时这次派工落成招领。
# DAOGANG_DSH_ROOT=

# 对影连通用的到岗单独 secret。不要填对影 .env 里的模型 Key。留空则 DuiyingHost.auth 为 unconfigured。
# 样例不要写进仓库。base URL 只能是本机 loopback，默认 http://127.0.0.1:8765。
# DAOGANG_DUIYING_SECRET=
# DAOGANG_DUIYING_BASE_URL=
